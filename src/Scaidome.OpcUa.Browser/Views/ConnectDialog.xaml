<UserControl x:Class="Scaidome.OpcUa.Browser.Views.ConnectDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Scaidome.OpcUa.Browser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ConnectViewModel}"
             Style="{StaticResource OverlayDialog}">

    <StackPanel Width="460">
        <TextBlock Text="Connect to OPC UA Server" Style="{StaticResource DialogTitle}"/>

        <!-- Recent connections -->
        <StackPanel Margin="0,0,0,16"
                    Visibility="{Binding RecentConnections.Count, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="Recent" Style="{StaticResource FieldLabel}"/>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentConnections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayText}" ToolTip="{Binding ServerUrl}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,4"
                                    Command="{Binding DataContext.SelectRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ConnectCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <CheckBox Content="Use message security (sign &amp; encrypt)" IsChecked="{Binding UseSecurity}"/>
        <CheckBox Content="Automatically trust the server certificate" IsChecked="{Binding AutoAcceptServerCertificate}"
                  Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="User name (empty = anonymous)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged"/>
            </StackPanel>
        </Grid>

        <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 Foreground="{StaticResource ErrorBrush}" Background="Transparent" BorderThickness="0" Padding="0"
                 MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                 Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"/>
            <Button Content="Connect" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
