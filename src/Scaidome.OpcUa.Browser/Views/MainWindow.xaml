<Window x:Class="Scaidome.OpcUa.Browser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Scaidome.OpcUa.Browser.ViewModels"
        xmlns:views="clr-namespace:Scaidome.OpcUa.Browser.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Scaidome Browser"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogsCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Scaidome Browser" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             Fill="{Binding Status, Converter={StaticResource ConnectionStatusToBrush}}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Connect" Style="{StaticResource PrimaryButton}"
                            Command="{Binding Connect.OpenCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                    <Button Content="Disconnect" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connected: address space | monitored items -->
        <Grid Grid.Row="1" Margin="16"
              Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Address space -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,12">
                        <TextBlock Text="Address Space" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Double-click, drag or press + to monitor a variable" FontSize="11"
                                   Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TreeView x:Name="AddressSpaceTree" Grid.Row="1" Margin="8,0,8,8"
                              ItemsSource="{Binding RootNodes}"
                              MouseDoubleClick="OnTreeDoubleClick"
                              PreviewMouseLeftButtonDown="OnTreePreviewMouseDown"
                              PreviewMouseMove="OnTreePreviewMouseMove">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:AddressSpaceNodeViewModel}" ItemsSource="{Binding Children}">
                                <Grid ToolTip="{Binding ToolTip}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Node.DisplayName}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Content="+" Margin="6,0,0,0"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Monitor this variable"
                                            Command="{Binding DataContext.MonitorNodeCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsVariable, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter TargetName="Name" Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Monitored items -->
            <Border Grid.Column="2" Style="{StaticResource Panel}"
                    AllowDrop="True" DragOver="OnMonitoredItemsDragOver" Drop="OnMonitoredItemsDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Monitored Items" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding MonitoredItems.Count, StringFormat=' ({0})'}"
                                       Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Add by Node ID…" Style="{StaticResource SecondaryButton}"
                                Padding="12,6"
                                Command="{Binding AddNodeById.OpenCommand}"/>
                    </Grid>

                    <!-- Notification banner -->
                    <Border Grid.Row="1" Margin="8,0,8,8" Padding="12,6" CornerRadius="4"
                            Background="#3A1D1D" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                            Visibility="{Binding Notification, Converter={StaticResource HasValueToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                                    Command="{Binding DismissNotificationCommand}"/>
                            <TextBlock Text="{Binding Notification}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="MonitoredItemsGrid" Grid.Row="2" Margin="8,0,8,8"
                              ItemsSource="{Binding MonitoredItems}" IsReadOnly="True">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveItemCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=MonitoredItemsGrid}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="170"/>
                            <DataGridTextColumn Header="Node ID" Binding="{Binding NodeId}" Width="200"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding DataTypeName}" Width="90"/>
                            <DataGridTemplateColumn Header="Status" Width="150" SortMemberPath="StatusCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:MonitoredItemViewModel}">
                                        <TextBlock Text="{Binding StatusText}" ToolTip="{Binding Error}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Severity, Converter={StaticResource StatusSeverityToBrush}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Source Time" Width="95"
                                                Binding="{Binding SourceTimestamp, Converter={StaticResource Timestamp}}"
                                                SortMemberPath="SourceTimestamp"/>
                            <DataGridTextColumn Header="Server Time" Width="95"
                                                Binding="{Binding ServerTimestamp, Converter={StaticResource Timestamp}}"
                                                SortMemberPath="ServerTimestamp"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Read" Style="{StaticResource IconButton}" ToolTip="Read the current value"
                                                    Command="{Binding DataContext.ReadItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Write" Style="{StaticResource IconButton}" ToolTip="Write a new value"
                                                    Command="{Binding DataContext.WriteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="✕" Style="{StaticResource IconButton}" ToolTip="Stop monitoring (Del)"
                                                    Foreground="{StaticResource ErrorBrush}"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Drop variables here from the address space"
                               Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding MonitoredItems.Count, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Not connected: welcome -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <TextBlock Text="Welcome to Scaidome Browser" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
            <TextBlock Text="Connect to an OPC UA server to browse its address space"
                       FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center"
                       Style="{StaticResource SecondaryText}"/>
            <Button Content="Connect to Server" Style="{StaticResource PrimaryButton}" Padding="24,12"
                    HorizontalAlignment="Center"
                    Command="{Binding Connect.OpenCommand}"/>
        </StackPanel>

        <!-- Dialogs -->
        <views:ConnectDialog Grid.RowSpan="2" DataContext="{Binding Connect}"/>
        <views:WriteValueDialog Grid.RowSpan="2" DataContext="{Binding WriteValue}"/>
        <views:AddNodeByIdDialog Grid.RowSpan="2" DataContext="{Binding AddNodeById}"/>
    </Grid>
</Window>
