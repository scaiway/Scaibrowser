<UserControl x:Class="Scaidome.OpcUa.Browser.Views.AddNodeByIdDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Scaidome.OpcUa.Browser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AddNodeByIdViewModel}"
             Style="{StaticResource OverlayDialog}">

    <StackPanel Width="420">
        <TextBlock Text="Add by Node ID" Style="{StaticResource DialogTitle}"/>

        <TextBlock Text="Node ID, e.g. ns=2;s=MyVariable or i=2258" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding NodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"/>
            <Button Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
