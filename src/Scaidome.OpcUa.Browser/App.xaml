<Application x:Class="Scaidome.OpcUa.Browser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Scaidome.OpcUa.Browser.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:HasValueToVisibilityConverter x:Key="HasValueToVisibility"/>
            <conv:ConnectionStatusToBrushConverter x:Key="ConnectionStatusToBrush"/>
            <conv:StatusSeverityToBrushConverter x:Key="StatusSeverityToBrush"/>
            <conv:TimestampConverter x:Key="Timestamp"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
